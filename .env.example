# Copy to .env for local development. Never commit real values.
# Staging and production values live in GitHub environment secrets (passed to Kamal at deploy time), never in files.

APP_ENV=development                     # development | test | staging | production
DEPLOYMENT_MODE=hosted                  # hosted (our keys) | byok (students' keys) | self_hosted
WEB_URL=http://localhost:3000
API_URL=http://localhost:8000
SOURCE_CODE_URL=https://github.com/RayanAlyasi/verdict  # AGPL: where users get this deployment's source; point it at your fork if you modify Verdict

# Database (docker compose provides this locally, with the same roles as staging and production)
DATABASE_URL=postgresql+psycopg://verdict_api:verdict_api@localhost:5432/verdict  # required; the api's role

# Sign-in (Better Auth with Google, in the web app). Create a separate Google OAuth client per environment.
BETTER_AUTH_SECRET=                     # required; openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_DATABASE_URL=postgresql://verdict_web:verdict_web@localhost:5432/verdict  # the web's role, limited to the `auth` schema
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks                     # the api verifies sign-in tokens with these public keys

# AI gateway. Platform keys are used in hosted mode; in byok mode students' keys are stored encrypted.
AI_PROVIDER=fake                        # fake gives canned answers, no key needed (development and tests only); auto uses the keys below
CREDENTIALS_MASTER_KEY=                 # encrypts students' keys (byok); openssl rand -base64 32; keep outside the database
ANTHROPIC_API_KEY=                      # required in hosted mode with AI_PROVIDER=auto; self-hosting needs it for real AI too
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
AI_DAILY_TOKEN_LIMIT_PER_USER=200000    # fair-use cap during the hosted feedback phase
AI_DAILY_SPEND_LIMIT_USD=5              # whole-platform daily AI spend cap; required in hosted mode

# File storage: local folder in dev, S3-compatible bucket in staging and production
STORAGE_DRIVER=local                    # local | s3
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Observability (optional)
SENTRY_DSN=
