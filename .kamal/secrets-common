# Read by Kamal for every destination. It holds references, not values: deploy.yml passes the
# environment's GitHub secrets. Keep this list, deploy.yml and docs/DEPLOYMENT.md in sync.
KAMAL_REGISTRY_USERNAME=$KAMAL_REGISTRY_USERNAME
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
BETTER_AUTH_SECRET=$BETTER_AUTH_SECRET
ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY
AI_DAILY_SPEND_LIMIT_USD=$AI_DAILY_SPEND_LIMIT_USD
CLOUDFLARE_TUNNEL_TOKEN=$CLOUDFLARE_TUNNEL_TOKEN
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
VERDICT_API_DB_PASSWORD=$VERDICT_API_DB_PASSWORD
VERDICT_WEB_DB_PASSWORD=$VERDICT_WEB_DB_PASSWORD
# The passwords are hex, so they need no escaping in a URL. The host is the database accessory.
DATABASE_URL=postgresql+psycopg://verdict_api:${VERDICT_API_DB_PASSWORD}@verdict-${KAMAL_DESTINATION}-db:5432/verdict
