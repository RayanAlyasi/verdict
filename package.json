{
  "name": "verdict",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --dir apps/web build",
    "lint": "prettier --check apps/web scripts package.json pnpm-workspace.yaml .prettierrc.json && pnpm --dir apps/web lint",
    "typecheck": "pnpm --dir apps/web typecheck",
    "test": "pnpm --dir apps/web test",
    "e2e": "pnpm --dir apps/web e2e",
    "e2e:screens": "pnpm --dir apps/web e2e:screens",
    "contract:check": "pnpm --dir apps/web contract:check"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
