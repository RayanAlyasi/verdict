{
  "name": "@verdict/web",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/tokens.mjs --check && lingui check sync && lingui check missing --mode catalog && eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test --project phone --project desktop",
    "e2e:screens": "playwright test --project screens",
    "tokens": "node scripts/tokens.mjs",
    "messages": "lingui extract --clean",
    "contract": "node scripts/contract.mjs",
    "contract:check": "node scripts/contract.mjs --check"
  },
  "dependencies": {
    "@lingui/core": "6.10.0",
    "@lingui/react": "6.10.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lingui/cli": "6.10.0",
    "@lingui/format-po": "6.10.0",
    "@lingui/loader": "6.10.0",
    "@lingui/swc-plugin": "6.7.1",
    "@next/env": "16.4.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "orval": "8.43.0",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
